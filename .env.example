# ---------------------------------------------------------------------------
# Northstar HQ — environment configuration
#
# Copy this file to `.env.local` and fill in the values:
#     cp .env.example .env.local
#
# `.env.local` is git-ignored. Never commit real keys.
#
# Anything marked REQUIRED must be set before the app will boot. The optional
# blocks each gate one feature: the app runs fully without them and the UI says
# what is missing rather than crashing.
# ---------------------------------------------------------------------------


# ===========================================================================
# REQUIRED — core
# ===========================================================================

# Database connection string.
#
# SQLite (local development, zero setup — the file is created for you):
DATABASE_URL="file:./prisma/dev.db"
#
# PostgreSQL (production). Swap the line above for something like:
# DATABASE_URL="postgresql://user:password@host:5432/northstar_hq?schema=public&sslmode=require"
#
# The Prisma schema is provider-portable; `npm run db:push` reads this value and
# targets the right engine automatically. No code changes required.

# Signs session cookies. 32+ bytes of base64 randomness.
#
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# There is deliberately NO fallback for this. Rotating it signs everyone out,
# which is also how you revoke every session at once in an emergency.
SESSION_SECRET=


# ===========================================================================
# REQUIRED IN PRODUCTION
# ===========================================================================

# The public origin, with no trailing slash.
#
# Invitation links, password-reset links and the Google OAuth redirect URI are
# all built from this. It is NOT derived from the request's Host header on
# purpose: a spoofed Host would otherwise turn a password-reset email into a
# working phishing link carrying a valid token.
APP_URL=http://localhost:3000


# ===========================================================================
# OPTIONAL — YouTube data (read-only, public data)
# ===========================================================================

# YouTube Data API v3 key, for tracking COMPETITOR channels (public data only).
#   1. https://console.cloud.google.com/  ->  create or pick a project
#   2. APIs & Services -> Library -> enable "YouTube Data API v3"
#   3. APIs & Services -> Credentials -> Create credentials -> API key
#   4. Restrict the key to the YouTube Data API v3.
#
# Quota: 10,000 units/day by default. A channel refresh costs roughly 1 unit per
# 50 videos, which is why syncing is scheduled rather than per page view.
YOUTUBE_API_KEY=


# ===========================================================================
# OPTIONAL — connecting Northstar's OWN YouTube channels (Google OAuth)
# ===========================================================================

# Without these, competitor tracking still works; you simply cannot connect
# your own Google account, and the Admin > YouTube page will say so.
#
#   1. https://console.cloud.google.com/apis/credentials
#   2. Create credentials -> OAuth client ID -> Web application
#   3. Authorised redirect URI:  <APP_URL>/api/youtube/callback
#      e.g. https://northstarhq.com/api/youtube/callback
#   4. OAuth consent screen: Internal, if Northstar uses Google Workspace.
#
# Northstar HQ requests read-only scopes only. It never asks for permission to
# upload, edit or delete, so a stolen token cannot alter your channels.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encrypts OAuth refresh tokens at rest with AES-256-GCM. Must decode to
# exactly 32 bytes. Required only once you connect a Google account.
#
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Losing this means stored connections cannot be decrypted and must be
# reconnected. Changing it has the same effect — back it up with your database.
APP_ENCRYPTION_KEY=


# ===========================================================================
# OPTIONAL — email delivery (invitations and password resets)
# ===========================================================================

# Without these, invitations still work: the admin copies the one-time link out
# of the Admin > Users screen and sends it themselves. Password resets fall back
# to writing the link to the SERVER LOG, never to the HTTP response.
#
# Resend is used because it is a plain HTTPS POST — no SMTP library, no native
# dependency in the build. https://resend.com
RESEND_API_KEY=

# The verified sender. The domain must be verified with the provider.
#     EMAIL_FROM="Northstar HQ <hq@northstarhq.com>"
EMAIL_FROM=


# ===========================================================================
# OPTIONAL — scheduled synchronisation
# ===========================================================================

# Shared secret for POST/GET /api/cron/sync, the endpoint an external scheduler
# calls to refresh channel data. That route has no session, so this secret is
# its only credential — treat it like a password.
#
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# If unset the cron route refuses to run at all rather than running
# unauthenticated. Send it as `Authorization: Bearer <secret>` (what Vercel Cron
# sends) or `x-cron-secret: <secret>`.
CRON_SECRET=

# Ceiling on channels refreshed in one scheduled run. Guards the daily quota
# against a large tracker list.
SYNC_MAX_CHANNELS_PER_RUN=25


# ===========================================================================
# OPTIONAL — session lifetime
# ===========================================================================

# Absolute cap on a session's life, in hours. Default 336 (14 days).
SESSION_TTL_HOURS=336

# Idle timeout in minutes. A browser left open on an unattended desk stops being
# a way in after this long without a request. Default 720 (12 hours).
SESSION_IDLE_TIMEOUT_MINUTES=720


# ===========================================================================
# OPTIONAL — Shorts classification tuning
# ===========================================================================

# Allow the youtube.com/shorts/{id} redirect probe. This is the single most
# reliable public signal for whether a video is a Short (the Data API exposes no
# such field) and it costs zero API quota. Set to "false" on networks that block
# or throttle youtube.com; the classifier then falls back to duration + player
# aspect ratio.
SHORTS_PROBE_ENABLED=true

# Max concurrent redirect probes. Keep this modest to stay a polite client.
SHORTS_PROBE_CONCURRENCY=6

# Per-probe timeout in milliseconds.
SHORTS_PROBE_TIMEOUT_MS=8000

# How far back a refresh walks a channel's uploads playlist, in days. Must
# exceed the longest period you want to analyse (180d) with headroom.
YOUTUBE_LOOKBACK_DAYS=400

# Hard ceiling on uploads-playlist pages fetched per channel refresh.
# 40 pages x 50 videos = 2,000 videos. Protects against pathological channels.
YOUTUBE_MAX_PAGES=40

# Minutes before a channel is considered stale and eligible for refresh.
# The team-wide value in Settings overrides this once the app is running.
REFRESH_INTERVAL_MINUTES=360
