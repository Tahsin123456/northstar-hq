# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — secrets never get committed, but the template must be.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database — the local SQLite file is developer-specific state, and
# prisma/.generated holds the provider-swapped schema built by
# scripts/prisma-run.mjs at run time.
/prisma/dev.db
/prisma/dev.db-journal
/prisma/*.db
/prisma/*.db-journal
# Any database copy, whatever it is named. The pattern above only catches a
# literal .db extension, so a file like dev.db.pre-auth-backup slipped past it
# and was committed once — a full copy of the company's tracked-channel and
# financial data heading for a remote repository.
/prisma/*.db.*
/prisma/*backup*
*.sqlite
*.sqlite3
/prisma/.generated/

# Generated production secrets, for pasting into the host. Never committed.
VERCEL-SETTINGS.local.txt

# Secret scratch files that must never be committed. Named broadly on purpose:
# a rule that only listed the one file it was written for is how the next one
# gets missed.
*.local.txt
NEW-SECRETS*

# Google credential check scratch file (holds a client secret).
GOOGLE-CREDENTIALS.local.txt
check-google-credentials.mjs
