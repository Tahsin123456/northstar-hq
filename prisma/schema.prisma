// ---------------------------------------------------------------------------
// Shorts Hit Rate — data model
//
// PORTABILITY CONTRACT
// This schema is deliberately written against the *intersection* of the
// PostgreSQL and SQLite Prisma connectors so that the exact same model can run
// on either. Concretely that means:
//
//   * no `enum` blocks          -> status/classification fields are `String`,
//                                  narrowed to union types in TypeScript and
//                                  validated with Zod at every boundary.
//   * no scalar list fields     -> SQLite has no array type.
//   * no `@db.*` native types   -> the two connectors spell them differently.
//
// The only provider-specific line in this file is `datasource.provider`, which
// `scripts/prisma-run.mjs` rewrites on the fly when DATABASE_URL points at a
// SQLite file. See docs in that script.
//
// TENANCY
// There are two kinds of ownership here, and conflating them is the mistake
// this schema exists to prevent:
//
//   * `Organization` owns everything the TEAM shares — tracked channels,
//     niches, notes, saved Shorts, hit thresholds, finance. Two people in the
//     same organization must see identical numbers, so these rows carry
//     `organizationId` and every query filters on it.
//   * `AppUser` owns identity, credentials, authorship and purely personal
//     display preferences. A shared row records its author via `createdById`
//     for the byline and the audit trail, but the author has no special claim
//     on it — research must outlive whoever happened to add it.
//
// Authorization is never expressed in this file. It lives in one place:
// src/lib/auth/permissions.ts for the rules, src/server/auth/dal.ts for the
// enforcement.
//
// HISTORICAL SNAPSHOTS
// `Video` stores the *latest* observed counters so the dashboard stays fast,
// while `VideoSnapshot` accumulates an append-only time series of the same
// counters. That split is what makes "views after 24h", "growth velocity" and
// "hit rate as of date X" possible later without a migration.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A person with an account.
///
/// Identity, credentials and authorship only. Everything a *team* shares —
/// channels, niches, notes, saved Shorts, thresholds — hangs off
/// `Organization`, not off this table. That split is the whole point: the Head
/// of Shorts and a Channel Director must see the same hit rate, and they
/// cannot if the data belongs to whoever happened to add it.
model AppUser {
  id    String  @id @default(cuid())
  /// Required and unique in practice — it is the login identifier. Kept
  /// nullable in the column only so the pre-auth row survives the migration;
  /// the invite/registration path always sets it.
  email String? @unique
  name  String?

  /// scrypt hash, encoded as `scrypt$N$r$p$salt$hash`. Null for an invited
  /// user who has not yet chosen a password — that account cannot log in.
  /// Never selected into any DTO. See src/server/auth/password.ts.
  passwordHash String?

  /// "invited" | "pending_approval" | "active" | "deactivated".
  ///
  /// `pending_approval` is the gate an invited person waits behind: they have
  /// accepted the invitation and chosen a password, but an administrator has
  /// not yet let them in. No new check enforces this — the session layer
  /// already refuses anything that is not "active", so the account simply
  /// cannot authenticate until it is approved.
  ///
  /// A String rather than an enum, per the portability contract at the top of
  /// this file; narrowed to a union and validated with Zod at every boundary.
  status String @default("invited")

  /// Set when an admin deactivates the account. The session DAL checks this on
  /// *every* request, so revocation takes effect on the next click rather than
  /// whenever a token happens to expire.
  deactivatedAt DateTime?

  /// Populated on successful login. Surfaced in the admin user list.
  lastLoginAt DateTime?

  /// Consecutive failed logins, and the lockout they triggered. Reset to zero
  /// on any success. This is per-account brute-force protection; per-IP
  /// throttling lives in RateLimitBucket.
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings    UserSettings?
  memberships OrganizationMember[]
  sessions    Session[]

  /// Authorship back-relations. Optional on the far side so removing a person
  /// nulls their byline instead of deleting the team's research.
  createdNiches          Niche[]
  createdTrackedChannels TrackedChannel[]
  createdNotes           Note[]
  createdCollections     Collection[]
  createdSavedShorts     SavedShort[]
  createdFinanceEntries  FinanceEntry[]
  connectedYouTube       YouTubeConnection[]
  auditEvents            AuditEvent[]
  invitationsSent        Invitation[]         @relation("InvitationCreatedBy")
  passwordResets         PasswordResetToken[]
  employeeProfile        EmployeeProfile?

  @@index([status])
  @@map("app_users")
}

// ---------------------------------------------------------------------------
// ORGANIZATION / TENANCY
//
// Northstar HQ is a single-tenant deployment today, but modelling the tenant
// explicitly is what makes "the team sees the same numbers" true by
// construction rather than by convention. Every shared resource carries an
// `organizationId`; every query filters on it; the DAL is the only thing that
// decides which one is in scope.
// ---------------------------------------------------------------------------

/// A team workspace.
model Organization {
  id   String @id @default(cuid())
  name String

  /// Lowercased, trimmed `name` — the same portable case-insensitive
  /// uniqueness trick Niche.slug and Collection.slug already use.
  slug String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings                OrganizationSettings?
  members                 OrganizationMember[]
  niches                  Niche[]
  trackedChannels         TrackedChannel[]
  notes                   Note[]
  collections             Collection[]
  savedShorts             SavedShort[]
  invitations             Invitation[]
  auditEvents             AuditEvent[]
  youtubeConnections      YouTubeConnection[]
  youtubeConnectionChannels YouTubeConnectionChannel[]
  financeCategories       FinanceCategory[]
  financeEntries          FinanceEntry[]
  exchangeRates           ExchangeRate[]
  employeeProfiles        EmployeeProfile[]
  payrollPeriods          PayrollPeriod[]
  notificationSettings    NotificationSettings?
  contentTypes            ContentType[]
  videoContentTypes       VideoContentType[]
  channelRevenueDays      ChannelRevenueDay[]
  videoHitEvaluations     VideoHitEvaluation[]
  channelContentTypeRules ChannelContentTypeRule[]

  @@map("organizations")
}

/// Membership and role.
///
/// A join model rather than a `role` column on AppUser so that one person can
/// belong to several workspaces later without restructuring, and because the
/// portability contract forbids scalar lists.
model OrganizationMember {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String
  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One of the role ids in src/lib/auth/roles.ts — "admin",
  /// "head_of_shorts", "channel_director", "creative_director", "viewer".
  ///
  /// Deliberately a String so a new role is a data change plus one entry in the
  /// role catalogue, never a migration.
  role String @default("channel_director")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grants MemberPermissionGrant[]
  niches MemberNiche[]

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

/// An individual permission granted to one member on top of their role.
///
/// This is what makes "Directors have no finance access *unless explicitly
/// granted*" expressible without inventing a bespoke role per person. Grants
/// are additive only: a grant can widen a role, never narrow it, so the role
/// remains a floor and there is exactly one way to lose access (change role or
/// revoke the grant).
model MemberPermissionGrant {
  id String @id @default(cuid())

  memberId String
  member   OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  /// A permission key from src/lib/auth/permissions.ts.
  permission String

  /// Attribution for the audit trail: who widened this person's access.
  grantedById String?
  grantedAt   DateTime @default(now())

  @@unique([memberId, permission])
  @@map("member_permission_grants")
}

/// Team-wide settings.
///
/// A field belongs here if changing it changes a number somebody else sees,
/// writes to the shared canonical Video rows, or spends the shared YouTube
/// quota. That is the entire reason this table is separate from UserSettings:
/// a hit rate must mean the same thing to everyone in the room.
model OrganizationSettings {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Default "is this Short a hit?" view threshold, in views.
  defaultThreshold Int @default(1000000)

  /// Default trailing window in days (7 / 30 / 90 / 180).
  defaultPeriodDays Int @default(30)

  /// Shared-quota and shared-canonical-data knobs. Per-user values here would
  /// let four directors quadruple the API spend and write one append-only
  /// snapshot series at four different cadences.
  lookbackDays            Int     @default(400)
  refreshIntervalMinutes  Int     @default(360)
  snapshotIntervalMinutes Int     @default(360)
  shortsProbeEnabled      Boolean @default(true)
  autoRefreshEnabled      Boolean @default(false)

  /// What share of raw views YouTube actually pays a Short against, in BASIS
  /// POINTS (hundredths of one percent). 5000 = 50.00%.
  ///
  /// WHY THIS EXISTS AT ALL. YouTube does not pay Shorts on the view count the
  /// public sees. It pays on ENGAGED views, a strictly smaller number that no
  /// API on this deployment reports: the Analytics data we can read gives money
  /// (`ChannelRevenueDay.estimatedRevenueMinor`) and raw public counters
  /// (`VideoSnapshot.viewCount`), and engaged views appear in neither. So the
  /// ratio cannot be measured here — it can only be assumed, and the owner's
  /// working assumption is "usually around 50%". Without this column, a rate
  /// quoted per 1,000 engaged views and then multiplied by raw views overstates
  /// earnings by roughly 2x. That is not a rounding error in a money figure
  /// somebody plans against; it is the difference between a niche paying for
  /// itself and not.
  ///
  /// UNITS, because getting the scale wrong here is silent and costs a factor
  /// of 100. Basis points, not percent and not a fraction. 50% is 5000, 47.5%
  /// is 4750, 100% is 10000. Whole percent was the obvious choice and is wrong:
  /// it cannot express 47.5%, and the granularity somebody wants from an
  /// assumption they are deliberately tuning is finer than the integer. Basis
  /// points also keep every downstream step integral and float-free, which the
  /// money rule in this schema requires:
  ///   engagedViews  = rawViews * shareBasisPoints / 10000
  ///   revenueMinor  = engagedViews * rpmMinorPerMillion / 1000000
  /// Both are exact divisions by a power of ten. A float share would have put a
  /// binary fraction directly upstream of every currency amount in the app.
  ///
  /// SCOPE: organization-wide, not per niche. This is a rule of thumb about how
  /// YouTube pays, not a property of the GTA niche versus the finance niche,
  /// and nothing in this system can ever measure it per niche. A per-niche
  /// column could only be filled with guesses while implying a precision no
  /// data source supports, and would land as twenty empty boxes on day one. It
  /// sits beside `defaultThreshold` and `defaultPeriodDays` because it is the
  /// same class of value: one shared analysis assumption the team argues about
  /// once. A per-niche override remains available later as a strictly additive
  /// nullable column on `Niche` where null means "inherit this".
  ///
  /// NOT NULL, DEFAULT 5000 — and this is the one place in this file where a
  /// default is the honest choice rather than the lazy one. Everywhere else
  /// (`hitThreshold`, `hitPaymentMinor`, the RPM range) null means "nobody has
  /// told us", and defaulting would launder a guess into a claim. Here the
  /// owner supplied the number himself, so 50% is a CONFIGURED value on his
  /// authority, not one the code invented. A nullable share would additionally
  /// make every manual money figure unrenderable on deploy until somebody
  /// visited Settings — switching off a working feature to honour a convention
  /// that does not apply. The honesty obligation is discharged in the UI
  /// instead, by naming the assumption next to the money ("at 50% engaged
  /// views"): a reader can dispute a stated assumption, but not a blank.
  ///
  /// RANGE: 1..10000, enforced in Zod at the boundary rather than by a CHECK,
  /// per this file's portability contract. Zero is REFUSED — it asserts that no
  /// view is ever engaged, which collapses every priced niche to $0, and a
  /// fabricated zero is precisely what the RPM module exists to keep off a
  /// screen. 10000 (100%) is ALLOWED: it is the identity, it is a coherent
  /// statement about the world rather than a fabrication, and it is the value
  /// that reproduces the pre-engaged-views arithmetic exactly, which makes it
  /// the honest way to opt out. Above 10000 is incoherent — engaged views are a
  /// subset of views. The consequence, worth stating plainly: 100% and "never
  /// configured" are indistinguishable in this column. That is acceptable here
  /// only because both produce identical, correct arithmetic, unlike the RPM
  /// case where unset and zero produce opposite sentences.
  ///
  /// APPLIES TO THE MANUAL RATE ONLY. `Niche.rpmLowMinorPerMillion` is entered
  /// per 1,000 ENGAGED views, so it needs this share. A rate DERIVED from an
  /// own channel's reported revenue is already money-over-RAW-views by
  /// construction — its numerator is what YouTube actually paid, net of its own
  /// engaged-view accounting, and its denominator is raw `VideoSnapshot`
  /// deltas. Applying this share to a derived rate would HALVE a measured
  /// figure. The two rates carry different bases and the resolver must say
  /// which; this column is not a licence to scale every rate it meets.
  engagedViewShareBasisPoints Int @default(5000)

  /// ISO 4217 code that consolidated financial totals are reported in.
  /// Individual entries always keep their own currency; see FinanceEntry.
  baseCurrency String @default("USD")

  /// Display name used on PDF reports and in the app shell.
  companyName String @default("Northstar Studios")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organization_settings")
}

/// A user-defined category for organising tracked channels ("GTA", "Finance").
///
/// Deliberately owned by a user rather than global: a niche is one person's
/// way of carving up their research, and two users tracking the same channel
/// will categorise it differently. Nothing here is hardcoded — the seeded set
/// is created on first use and is fully editable.
model Niche {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Who added this. `@map("userId")` keeps the original physical column, so
  /// this is a Prisma-level rename and no attribution is rewritten. Nullable
  /// with SetNull because a shared niche must outlive the person who created it —
  /// the previous Cascade would have deleted the team's research along with a
  /// departing account.
  createdById String?  @map("userId")
  createdBy   AppUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  name String

  /// Lowercased, trimmed `name`. Exists so "GTA" and "gta" cannot both be
  /// created — case-insensitive uniqueness that works identically on SQLite
  /// and PostgreSQL, neither of which agrees with the other about how to do
  /// case-insensitive collation.
  slug String

  /// Optional accent token (a `--chart-N` index) used for the niche chip.
  colorIndex Int @default(0)

  /// "production" | "watchlist".
  ///
  /// Two genuinely different jobs wearing one word. A PRODUCTION niche is one
  /// the studio publishes into: it has a hit rule, it pays, its numbers are a
  /// scorecard, and the team is accountable for them. A WATCHLIST niche is one
  /// they watch — for formats worth stealing, for an opening nobody is filling,
  /// for a competitor's system worth reading. Nobody is judged on it.
  ///
  /// Keeping them in one list made the average meaningless: a watchlist niche
  /// full of channels nobody is trying to beat drags the portfolio hit rate
  /// toward a number describing work the studio does not do. Splitting them is
  /// what lets "our hit rate" mean ours.
  kind String @default("production")

  /// What counts as a hit in this niche, in views.
  ///
  /// Nullable on purpose: null means "inherit the account default" rather than
  /// silently baking the current default into every niche at creation time. A niche
  /// that has never been configured should follow the global setting if the
  /// user later changes it.
  /// What ONE hit in this niche pays, in minor units.
  ///
  /// The rate moved here from `EmployeeProfile.hitPaymentMinor` because it is a
  /// property of the work, not of the person: a hit in a niche that takes a day
  /// to produce is not worth the same as one that takes an hour, and paying two
  /// editors different amounts for the identical Short was never what anybody
  /// meant. The employee column stays for the finalized records that reference
  /// it — a paid bonus must remain explicable — and no longer decides new pay.
  ///
  /// Null is unconfigured, like the two rule columns below it. A niche that
  /// cannot say what a hit is worth pays nothing rather than guessing zero, and
  /// the payroll run says which niche and why before anybody finalizes it.
  hitPaymentMinor Int?

  hitThreshold Int?

  /// How long a Short has to reach `hitThreshold`, in hours.
  ///
  /// THIS IS WHAT MAKES A HIT A HIT. "A million views" is not a standard — a
  /// Short published in February has had months to get there and one published
  /// on Thursday has had days, so the old lifetime comparison reported the
  /// publishing calendar as if it were quality. Measured on real data, the same
  /// channels scored 5.9% for Shorts under a week old and 18.8% at 30–90 days
  /// with nothing about the work changing.
  ///
  /// Adding a clock fixes that by construction: every Short is judged on the
  /// same stretch of its own life, so the number stops moving when the release
  /// schedule does.
  ///
  /// Hours rather than days because Shorts move fast enough that a 48-hour rule
  /// is a reasonable thing for a team to want, and a day-based column could not
  /// express it. The UI talks in days where days are what somebody means.
  ///
  /// Null means unconfigured, exactly as `hitThreshold` does — and a niche needs
  /// BOTH before it can score anything. Half a rule is not a rule.
  hitWindowHours Int?

  /// What 1,000 views in this niche are worth, entered by hand as a LOW–HIGH
  /// range.
  ///
  /// The question these answer is not "what did we earn" — `ChannelRevenueDay`
  /// already answers that, and only for channels we own. It is "how big is this
  /// niche, and how much of it are we capturing", which needs a rate that can be
  /// applied to competitors whose earnings nobody will ever show us.
  ///
  /// UNITS: minor units per 1,000,000 VIEWS, not per 1,000. A Shorts RPM sits
  /// well under $0.10, so whole cents per 1,000 views cannot express one at all —
  /// $0.045 would have to round to 4 or 5, an 11% error in the rate, and that
  /// error is then multiplied by the niche's entire view count. Carrying a
  /// further factor of 1,000 makes the granularity $0.00001 per 1,000 views and
  /// keeps every step integral: revenueMinor = views * rpm / 1000000, an exact
  /// division by a power of ten with no float anywhere. $1.00 per 1,000 views is
  /// stored as 100000; $0.045 is stored as 4500.
  ///
  /// A RANGE rather than a point because a guess IS a range. Whoever fills this
  /// in has no measurement to enter — they have a band they believe the niche
  /// pays in — and demanding a single number would launder that belief into a
  /// figure the screen then presents with more confidence than it was given.
  /// Both columns or neither, the same rule `hitThreshold` and `hitWindowHours`
  /// follow above: half a range is not a range. `low <= high`, with equality
  /// allowed for somebody who genuinely does mean one number.
  ///
  /// Null is unconfigured and is NOT zero, which is the distinction the whole
  /// nullability exists for. Zero is a claim that this niche pays nothing; null
  /// is the absence of a claim. They render as opposite sentences and must never
  /// collapse into each other — the same reason `hitPaymentMinor` above is
  /// nullable rather than defaulted.
  ///
  /// This range is the FALLBACK in the owner's ordering, behind a rate derived
  /// from a monetized channel the studio operates in the niche. On this
  /// deployment it is nonetheless the only path that yields a number today: with
  /// `OrganizationSettings.autoRefreshEnabled` false there are no `VideoSnapshot`
  /// rows, so views-gained-in-a-window — the denominator every derived rate needs
  /// — is not computable for anybody. See the note below the currency column.
  rpmLowMinorPerMillion  Int?
  rpmHighMinorPerMillion Int?

  /// ISO 4217 code the range above was entered in. Null exactly when the range
  /// is null.
  ///
  /// Stored rather than inherited from `OrganizationSettings.baseCurrency`, for
  /// the reason stated on that column: individual entries always keep their own
  /// currency. A range typed as 0.03–0.06 USD must not silently become 0.03–0.06
  /// EUR on the day an admin switches the base — that is a number nobody entered,
  /// sitting in a figure somebody plans against. Conversion into the base happens
  /// on read, in `resolveNicheRpm`, using the organization's own ExchangeRate
  /// rows in the one direction they were entered — never inverted, matching the
  /// ledger's `resolveConversion`. With no rate configured it REFUSES: the niche
  /// resolves to `{ source: "none", reason: "manual_range_unconvertible" }` and
  /// the card names the stored range and the missing rate, rather than inventing
  /// a conversion or printing the digits under the base currency's symbol. The
  /// range as typed still travels to the browser, as `enteredRange`, so the
  /// dialog seeds the boxes with what somebody actually entered.
  rpmCurrency String?

  // NOTHING IS STORED FOR THE *DERIVED* RATE, deliberately.
  //
  // Where the studio owns a monetized channel in this niche, that channel's own
  // RPM overrides the range above. It is reported revenue over views gained in
  // the same window, and both halves of that fraction keep moving after the
  // fact: YouTube revises daily revenue for weeks (see ChannelRevenueDay's
  // revision columns), and snapshots keep landing. A stored derived rate would
  // therefore be a number that was true once, going quietly stale while still
  // being presented as measured rather than estimated — strictly worse than not
  // having it, because it looks authoritative. It is computed on read instead,
  // and carried with the window, channel count and view count it came from so
  // the reader can judge it. Storing it would also duplicate own-channel revenue
  // into a table read under a weaker permission than the finance one.

  /// Manual ordering in the filter menu; ties break alphabetically.
  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channels     TrackedChannelNiche[]
  notes        Note[]
  memberNiches MemberNiche[]

  @@unique([organizationId, slug])
  @@index([organizationId, sortOrder])
  @@index([createdById])
  @@map("niches")
}

/// Join between a user's tracked channel and a niche.
///
/// A real relation rather than a delimited string, so a channel can carry
/// several niches ("Gaming" + "GTA") and filtering is an indexed join instead
/// of a LIKE scan.
model TrackedChannelNiche {
  id String @id @default(cuid())

  trackedChannelId String
  trackedChannel   TrackedChannel @relation(fields: [trackedChannelId], references: [id], onDelete: Cascade)

  nicheId String
  niche   Niche  @relation(fields: [nicheId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([trackedChannelId, nicheId])
  @@index([nicheId])
  @@map("tracked_channel_niches")
}

/// Personal display preferences.
///
/// A field belongs in this table if and only if changing it cannot change what
/// anybody else sees. Sort order qualifies. The hit threshold and the trailing
/// period do not — those are the numbers the team argues about, so they live on
/// OrganizationSettings and there is exactly one of them.
model UserSettings {
  id     String  @id @default(cuid())
  userId String  @unique
  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Default dashboard sort. Column key + direction.
  defaultSortKey       String @default("hitRate")
  defaultSortDirection String @default("desc")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_settings")
}

/// A YouTube channel as a *global* entity, deduplicated by its canonical
/// channel id. Multiple users can track the same channel without refetching.
model Channel {
  id               String  @id @default(cuid())
  youtubeChannelId String  @unique
  handle           String?
  title            String
  customUrl        String?
  description      String  @default("")
  avatarUrl        String?
  bannerUrl        String?
  country          String?

  /// Counters are BigInt: channel lifetime views routinely exceed 2^31.
  subscriberCount       BigInt?
  hiddenSubscriberCount Boolean @default(false)
  viewCount             BigInt?
  videoCount            BigInt?

  /// The "uploads" playlist id; walking it is far cheaper than search.list.
  uploadsPlaylistId String?

  channelPublishedAt DateTime?

  lastFetchedAt   DateTime?
  lastFetchStatus String    @default("never")
  lastFetchError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  videos         Video[]
  trackedBy      TrackedChannel[]
  refreshRuns    ChannelRefreshRun[]
  notes          Note[]
  financeEntries FinanceEntry[]
  revenueDays    ChannelRevenueDay[]

  @@index([lastFetchedAt])
  @@map("channels")
}

/// Join between a user and a channel they track. Removing a channel from the
/// tracker flips `isActive` (soft delete) so the historical Video and
/// VideoSnapshot rows survive and the channel can be restored intact.
model TrackedChannel {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Who added this. `@map("userId")` keeps the original physical column, so
  /// this is a Prisma-level rename and no attribution is rewritten. Nullable
  /// with SetNull because a tracked channel must outlive the person who created it —
  /// the previous Cascade would have deleted the team's research along with a
  /// departing account.
  createdById String?  @map("userId")
  createdBy   AppUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  /// Optional user-supplied label that overrides the YouTube title in the UI.
  label String?

  /// "own" | "competitor" — whether Northstar operates this channel.
  ///
  /// Lives here rather than on Channel because it describes the *relationship*,
  /// not the channel: the same YouTube channel is "own" to its operator and
  /// "competitor" to everyone else. Defaults to "competitor" because almost
  /// every channel added to a research tracker is one.
  ownershipType String @default("competitor")

  isActive  Boolean   @default(true)
  removedAt DateTime?

  addedAt   DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  niches           TrackedChannelNiche[]
  contentTypeRules ChannelContentTypeRule[]

  @@unique([organizationId, channelId])
  @@index([organizationId, isActive])
  @@index([organizationId, ownershipType])
  @@index([createdById])
  @@map("tracked_channels")
}

/// One YouTube video. Both Shorts and long-form are stored; `isShort` plus
/// `classification` decide what the analytics engine is allowed to consume.
/// Long-form rows are kept so the classifier can be re-run and audited later.
model Video {
  id             String  @id @default(cuid())
  youtubeVideoId String  @unique
  channelId      String
  channel        Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  title           String
  description     String   @default("")
  publishedAt     DateTime
  durationIso     String
  durationSeconds Int
  thumbnailUrl    String?
  videoUrl        String

  viewCount    BigInt  @default(0)
  likeCount    BigInt?
  commentCount BigInt?

  /// --- Shorts classification (see server/services/youtube/shorts-detector) ---
  /// `isShort` is the boolean the analytics engine filters on. It is only ever
  /// true when classification === "short"; "uncertain" videos are excluded
  /// conservatively so they can never inflate a hit rate.
  isShort                  Boolean   @default(false)
  /// "short" | "not_short" | "uncertain"
  classification           String    @default("uncertain")
  classificationConfidence Float     @default(0)
  classificationMethod     String    @default("none")
  classificationReason     String    @default("")
  classifiedAt             DateTime?

  /// Aspect-ratio evidence harvested from the oEmbed player, when available.
  playerWidth  Int?
  playerHeight Int?
  aspectRatio  Float?

  /// False once YouTube stops returning the video (deleted / private).
  isAvailable    Boolean  @default(true)
  statsFetchedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  snapshots      VideoSnapshot[]
  hitEvaluations VideoHitEvaluation[]
  notes          Note[]
  savedShorts    SavedShort[]
  contentTypes   VideoContentType[]

  @@index([channelId, publishedAt])
  @@index([channelId, isShort, publishedAt])
  @@index([channelId, isShort, viewCount])
  @@index([publishedAt])
  @@map("videos")
}

/// Append-only history of a video's public counters. Written at most once per
/// `snapshotIntervalMinutes` per video, and only when something changed.
model VideoSnapshot {
  id      String @id @default(cuid())
  videoId String
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  viewCount    BigInt
  likeCount    BigInt?
  commentCount BigInt?

  /// Age of the video at capture time, in hours. Precomputed so "views after
  /// 24h / 48h / 7d" is a range scan rather than a join against Video.
  videoAgeHours Int

  /// When this reading was taken, SNAPPED DOWN TO A FIVE-MINUTE GRID.
  ///
  /// The rounding is what makes the unique below enforceable. Two syncs of the
  /// same channel can genuinely overlap — the hourly sweep and somebody pressing
  /// Refresh — and each reads the previous snapshot before either writes, so the
  /// "has the interval elapsed?" guard in `channel-sync` passes twice and both
  /// insert. That produced two near-identical rows seconds apart, which is not a
  /// duplicate video but IS duplicate time-series data, and it skews every
  /// per-interval delta computed from it.
  ///
  /// A unique on the raw instant would not have caught it (the two runs differ
  /// by milliseconds). A unique on a five-minute bucket does: it is far coarser
  /// than the race window and far finer than the densest cadence this app ever
  /// schedules, which is hourly. The cost is that `capturedAt` is the reading's
  /// bucket rather than the instant of the HTTP call — up to five minutes early,
  /// against a column whose consumers all work in hours.
  capturedAt DateTime @default(now())

  /// Idempotency, enforced by the database rather than by timing. Replaces the
  /// plain [videoId, capturedAt] index, which this serves identically.
  @@unique([videoId, capturedAt])
  @@index([capturedAt])
  @@map("video_snapshots")
}

/// Audit trail for refreshes: what a run cost, what it found, why it failed.
/// Also the source of truth for "do not hammer the API" back-off decisions.
model ChannelRefreshRun {
  id        String  @id @default(cuid())
  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  /// "running" | "success" | "partial" | "error"
  status  String @default("running")
  trigger String @default("manual")

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  videosDiscovered Int @default(0)
  videosUpdated    Int @default(0)
  shortsClassified Int @default(0)
  snapshotsWritten Int @default(0)
  quotaUnitsUsed   Int @default(0)

  error String?

  @@index([channelId, startedAt])
  @@map("channel_refresh_runs")
}

// ---------------------------------------------------------------------------
// RESEARCH LAYER
//
// Notes, saved Shorts and collections turn the tool from a dashboard into a
// workflow: discover -> analyse -> save -> note -> revisit. All of it is
// user-scoped and hangs off the same canonical Channel / Video rows the
// analytics read, so there is exactly one source of truth for view counts,
// upload dates and Shorts classification.
// ---------------------------------------------------------------------------

/// A free-text note attached to a channel, a niche, or a single Short.
///
/// Three nullable foreign keys rather than a polymorphic (targetType, targetId)
/// pair: this keeps real referential integrity and cascade deletes, so a note
/// can never outlive the thing it annotates or point at a row that no longer
/// exists. `targetType` is stored alongside purely to make queries and the UI
/// unambiguous without inspecting which column is null.
model Note {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Who added this. `@map("userId")` keeps the original physical column, so
  /// this is a Prisma-level rename and no attribution is rewritten. Nullable
  /// with SetNull because a team note must outlive the person who created it —
  /// the previous Cascade would have deleted the team's research along with a
  /// departing account.
  createdById String?  @map("userId")
  createdBy   AppUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  /// "channel" | "niche" | "video"
  targetType String

  channelId String?
  channel   Channel? @relation(fields: [channelId], references: [id], onDelete: Cascade)

  nicheId String?
  niche   Niche?  @relation(fields: [nicheId], references: [id], onDelete: Cascade)

  videoId String?
  video   Video?  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  body String

  /// A YouTube Short from outside the tracker.
  ///
  /// Deliberately NOT the `videoId` relation above. That one points at a `Video`
  /// row, which exists only for channels this organization tracks — and the
  /// whole point of this field is the competitor's Short somebody just watched,
  /// which by definition is not in the database and should not be added to it.
  /// Tracking a channel is a decision with a sync cost; quoting one Short in a
  /// note is not, and conflating them would make every pasted link quietly
  /// enlarge the tracker.
  ///
  /// The two coexist: a note may be filed against a tracked channel AND quote an
  /// outside Short as the comparison that prompted it.
  externalVideoId String?

  /// The canonical URL, rebuilt from the id rather than stored as pasted.
  ///
  /// A safety property, not tidiness. This value is rendered as a link, so
  /// storing whatever arrived in the request body would put an attacker-chosen
  /// string into an href — `javascript:` and friends. Parsing out the video id
  /// and composing the URL here means the column can only ever hold a
  /// youtube.com address, whatever was pasted.
  externalUrl String?

  /// Best-effort metadata, allowed to stay null.
  ///
  /// Fetching this must never block saving the link, so a note whose lookup
  /// failed — no API key, quota spent, video private — keeps its URL and shows
  /// the thumbnail, which derives from the id alone and needs no request.
  externalTitle        String?
  externalChannelTitle String?

  /// "personal" | "shared".
  ///
  /// A personal note is working memory — visible to its author, and to an admin
  /// who is accountable for the workspace. A shared note is team research, and
  /// is visible to any colleague who can already see the thing it is about:
  /// a shared note on a Red Dead channel reaches whoever can see Red Dead, and
  /// nobody else. That is why the check is not "is it shared" alone but "is it
  /// shared AND is its subject in your scope" — otherwise sharing a note would
  /// be a way to hand somebody a niche they were never assigned.
  ///
  /// Defaults to personal. Making a note visible to colleagues is a decision
  /// somebody takes deliberately; it should never be what happens when they do
  /// not think about it.
  visibility String @default("personal")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, visibility])
  @@index([organizationId, targetType])
  @@index([createdById])
  @@index([channelId])
  @@index([nicheId])
  @@index([videoId])
  @@map("notes")
}

/// A user-defined folder for saved Shorts ("GTA Hooks", "Ideas to Recreate").
model Collection {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Who added this. `@map("userId")` keeps the original physical column, so
  /// this is a Prisma-level rename and no attribution is rewritten. Nullable
  /// with SetNull because a collection must outlive the person who created it —
  /// the previous Cascade would have deleted the team's research along with a
  /// departing account.
  createdById String?  @map("userId")
  createdBy   AppUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  name String
  /// Lowercased name; enforces case-insensitive uniqueness portably.
  slug String

  colorIndex Int @default(0)
  sortOrder  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items SavedShortCollection[]

  @@unique([organizationId, slug])
  @@index([organizationId, sortOrder])
  @@index([createdById])
  @@map("collections")
}

/// A bookmarked Short.
///
/// The `*AtSave` columns are a deliberate point-in-time capture, not a cache.
/// They are what lets the UI show "1.2M -> 4.8M": the whole value of saving a
/// Short early is being able to see, later, how far it ran after you spotted
/// it. Recomputing those numbers from today's data would destroy exactly the
/// information the feature exists to preserve.
model SavedShort {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Who added this. `@map("userId")` keeps the original physical column, so
  /// this is a Prisma-level rename and no attribution is rewritten. Nullable
  /// with SetNull because a saved Short must outlive the person who created it —
  /// the previous Cascade would have deleted the team's research along with a
  /// departing account.
  createdById String?  @map("userId")
  createdBy   AppUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  videoId String
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  viewsAtSave           BigInt
  channelMedianAtSave   BigInt?
  outlierMultipleAtSave Float?

  savedAt DateTime @default(now())

  collections SavedShortCollection[]

  /// PER PERSON, not per organization.
  ///
  /// This was `[organizationId, videoId]`, which made saving org-wide: the
  /// first person to save a Short claimed it, and nobody else could save it at
  /// all — their colleague's shortlist was their shortlist. A saved Short is
  /// personal working state, so the key carries the owner.
  ///
  /// `createdById` is nullable and NULLs do not collide on either connector, so
  /// saves whose owner has since been deleted stop deduplicating against each
  /// other. That is the right trade: they are already orphaned records kept for
  /// the audit trail, not a live shortlist anybody is adding to.
  @@unique([organizationId, createdById, videoId])
  @@index([organizationId, savedAt])
  @@index([createdById])
  @@map("saved_shorts")
}

/// Join: a saved Short can sit in several collections, or none at all.
model SavedShortCollection {
  id String @id @default(cuid())

  savedShortId String
  savedShort   SavedShort @relation(fields: [savedShortId], references: [id], onDelete: Cascade)

  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([savedShortId, collectionId])
  @@index([collectionId])
  @@map("saved_short_collections")
}

// ---------------------------------------------------------------------------
// AUTHENTICATION
//
// Sessions are database rows, not stateless tokens. That is a deliberate
// trade: a JWT would avoid a query per request but stays valid until it
// expires, so a deactivated employee would keep access for hours. Here the row
// *is* the truth, and revoking it — or deactivating the user — takes effect on
// the very next request.
//
// TOKEN STORAGE
// The cookie carries a high-entropy random token; this table stores only its
// SHA-256 hash. A database leak therefore yields no usable session, in exactly
// the way password hashing protects passwords. The same pattern is used for
// invitations and password resets.
// ---------------------------------------------------------------------------

/// One signed-in browser.
model Session {
  id String @id @default(cuid())

  userId String
  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the random token held in the cookie. Unique so lookup is a
  /// single indexed read; the raw token is never stored anywhere.
  tokenHash String @unique

  expiresAt DateTime
  /// Set on logout, on "sign out everywhere", and when an admin deactivates
  /// the account. A non-null value fails the session check immediately.
  revokedAt DateTime?

  /// Rolling activity, used for the idle timeout and the admin's device list.
  lastSeenAt DateTime @default(now())

  /// Coarse device information for the audit trail. Deliberately just the
  /// user-agent string and IP — enough to recognise "this was not me", not a
  /// behavioural log.
  userAgent String?
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// A pending invitation to join the organization.
///
/// The invite flow exists so an admin never handles an employee's password:
/// they create the account shell and the employee sets their own secret. The
/// token is single-use and time-boxed.
model Invitation {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  email String
  name  String?
  role  String  @default("channel_director")

  /// SHA-256 of the token embedded in the invitation link.
  tokenHash String @unique

  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?

  createdById String?
  createdBy   AppUser? @relation("InvitationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, email])
  @@index([expiresAt])
  @@map("invitations")
}

/// A single-use password reset token.
model PasswordResetToken {
  id String @id @default(cuid())

  userId String
  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// Fixed-window counter backing the auth rate limiter.
///
/// Stored in the database rather than in process memory on purpose: an
/// in-memory counter resets on every deploy and is per-instance, so two
/// containers would each grant the full allowance. This is the one place where
/// a write per request is worth it.
model RateLimitBucket {
  /// "<scope>:<subject>", e.g. "login:ip:203.0.113.7" or
  /// "login:email:someone@example.com".
  key String @id

  count           Int      @default(0)
  windowStartedAt DateTime @default(now())
  expiresAt       DateTime

  @@index([expiresAt])
  @@map("rate_limit_buckets")
}

// ---------------------------------------------------------------------------
// AUDIT
//
// Accountability, not surveillance. The log records administrative and
// financial actions — who changed a role, who added a channel, who edited an
// earnings row — and deliberately does NOT record page views, searches, or
// which dashboards someone looked at.
// ---------------------------------------------------------------------------

/// One recorded action.
model AuditEvent {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Null when the actor's account was later deleted, or for system actions
  /// such as a scheduled sync.
  actorUserId String?
  actor       AppUser? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  /// Denormalised so the log stays readable after an account is removed.
  actorLabel String?

  /// A key from src/lib/audit/actions.ts, e.g. "user.deactivated".
  action String

  /// What was acted on: "user" | "channel" | "niche" | "finance_entry" | ...
  targetType  String?
  targetId    String?
  targetLabel String?

  /// Human-readable one-line description, written at record time so the log
  /// does not depend on the target row still existing.
  summary String

  /// Additional structured context as a JSON string. A String rather than
  /// Json because the portability contract keeps the schema on the
  /// SQLite/PostgreSQL intersection.
  metadata String?

  /// Recorded only for security-relevant events (sign-in, role change,
  /// deactivation, finance edits) so an anomaly can be investigated. Not
  /// collected for ordinary reads.
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, action])
  @@index([actorUserId])
  @@map("audit_events")
}

// ---------------------------------------------------------------------------
// YOUTUBE ACCOUNT CONNECTIONS
//
// OAuth, never passwords. Northstar connects its own Google account, grants
// read-only YouTube scopes, and Northstar HQ stores the resulting tokens
// encrypted at rest (AES-256-GCM, key from APP_ENCRYPTION_KEY). Tokens are
// never sent to the browser and never appear in any DTO.
// ---------------------------------------------------------------------------

/// A connected Google account authorising access to one or more own channels.
model YouTubeConnection {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// The Google account that granted access. Shown in the admin UI so it is
  /// obvious whose authorisation a sync depends on.
  googleAccountEmail String?
  googleUserId       String?

  /// The YouTube channel this connection owns, once resolved.
  youtubeChannelId String?
  channelTitle     String?

  /// AES-256-GCM ciphertext. Never selected into a DTO, never logged.
  accessTokenEnc  String?
  refreshTokenEnc String?

  /// When the current access token stops working; the refresh token is used to
  /// mint a new one.
  accessTokenExpiresAt DateTime?

  /// Space-separated scopes actually granted, so the app can detect a
  /// downgrade rather than failing opaquely at call time.
  scope String @default("")

  /// "connected" | "needs_reauth" | "revoked"
  status String  @default("connected")
  lastError String?

  /// The last time this connection was used successfully for ANYTHING.
  ///
  /// Written by both halves that spend the grant — the channel/video sync and
  /// the revenue read — because that is the claim the admin screen's "Last
  /// sync" makes. It used to be written only by a successful revenue report,
  /// which meant a connection without the monetary scope read "Never synced"
  /// forever while its channel had been syncing correctly every hour.
  lastSyncAt DateTime?

  /// "never" | "ok" | "error" — how the last CHANNEL/VIDEO sync through this
  /// connection went, as distinct from the revenue read below.
  ///
  /// Separate from `status`, and the distinction is the point. `status` is about
  /// the GRANT: "needs_reauth" means Google will not honour the credentials any
  /// more and a human must reconnect. This is about the RUN: a channel that was
  /// deleted, an exhausted quota, a 403 that is not a dead grant. Those leave a
  /// perfectly healthy connection failing every hour, and folding them into
  /// `status` would tell an admin to reconnect an account that is fine.
  channelSyncStatus String    @default("never")
  channelSyncError  String?
  lastChannelSyncAt DateTime?

  /// Whether the monetary Analytics scope was actually granted.
  ///
  /// Revenue does not come from the YouTube Data API at all — it needs
  /// yt-analytics-monetary.readonly against the YouTube Analytics API. A
  /// connection made before that scope was requested, or one where the person
  /// unticked it on the consent screen, can read channel data and not a penny
  /// of revenue. Recording it means the UI can say "reconnect to enable
  /// revenue" instead of reporting an error every night.
  revenueScopeGranted Boolean @default(false)

  /// "unknown" | "monetized" | "not_monetized"
  ///
  /// Monetary metrics require the channel to be in the YouTube Partner
  /// Programme. A channel below the threshold is not an error to be retried —
  /// it is a fact to be displayed, which is why it is a status rather than a
  /// message in lastError.
  monetizationStatus String @default("unknown")

  /// "never" | "ok" | "error" | "no_scope" | "not_monetized" | "reported_zero"
  ///
  /// "not_monetized" is YouTube refusing a report to a connection that has
  /// permission to read one; "reported_zero" is YouTube answering with nothing
  /// but zeros. Separate values because they are separate facts — the first is
  /// evidence about the channel, the second is only evidence about the window.
  revenueSyncStatus String    @default("never")
  revenueSyncError  String?
  lastRevenueSyncAt DateTime?

  /// When the scheduler will next look. Shown to the admin so "nothing has
  /// happened yet" is distinguishable from "nothing is going to happen".
  nextSyncAt DateTime?

  connectedById String?
  connectedBy   AppUser? @relation(fields: [connectedById], references: [id], onDelete: SetNull)

  /// Every channel this grant provably covers — see YouTubeConnectionChannel.
  coveredChannels YouTubeConnectionChannel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, youtubeChannelId])
  @@index([organizationId, status])
  @@map("youtube_connections")
}

/// One channel a connection's grant provably covers, so it can be READ with
/// that grant.
///
/// WHY THIS TABLE EXISTS, AND WHAT IT REPAIRS
/// A connection row is keyed on exactly ONE `youtubeChannelId` — the channel
/// Google scoped the consent to, which is what the (organization, channel)
/// unique is for. But discovery and tracking are one-to-many: `mine=true` is
/// read with `maxResults=50` on purpose, and `trackOwnChannel` will add any
/// channel the token reports owning.
///
/// Before this table, channels two through N of a single grant were invisible to
/// the credential lookup, which keys on the connection's single id. They were
/// marked "own" and then read with the SHARED PUBLIC API KEY — silently, because
/// a public read succeeds. That is precisely the substitution the whole OAuth
/// path exists to prevent, and it failed closed nowhere: the numbers simply
/// changed meaning.
///
/// So the mapping lives here, one row per channel, and the credential lookup
/// reads it. The (organization, channel) unique means a channel resolves to at
/// most one grant — the most recent one to claim it wins, by upsert — so two
/// connections can never fight over whose token reads a channel.
model YouTubeConnectionChannel {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  connectionId String
  connection   YouTubeConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  /// YouTube's own id, not the internal Channel row id: this is resolved before
  /// (and independently of) anything being tracked.
  youtubeChannelId String
  title            String?

  /// When the connection last CONFIRMED it owns this channel, from Google's own
  /// answer. Not a guess and not user input — see `trackOwnChannel`.
  confirmedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, youtubeChannelId])
  @@index([connectionId])
  @@map("youtube_connection_channels")
}

// ---------------------------------------------------------------------------
// FINANCE
//
// Revenue and expenses share one table because every question the product asks
// — net profit, margin, profit by channel, revenue vs expenses over time — is
// a difference between two sums over the same dimensions. Two tables would
// mean two period filters, two currency conversions and two chances to drift.
//
// MONEY REPRESENTATION
// Amounts are integer minor units (cents/kuruş), never floats: 0.1 + 0.2 is
// not 0.3 in binary floating point, and a financial total that is off by a
// cent is a bug report. The original currency is always preserved alongside
// the converted base figure, so no conversion ever destroys the source record.
// ---------------------------------------------------------------------------

/// A configurable revenue or expense category.
model FinanceCategory {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// "revenue" | "expense" — which side of the ledger this category belongs
  /// to. Kept on the category so the entry form can only offer sensible
  /// options.
  kind String

  name String
  /// Lowercased name; portable case-insensitive uniqueness within a kind.
  slug String

  sortOrder  Int     @default(0)
  /// Archived rather than deleted, so historical entries keep their label.
  isArchived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries FinanceEntry[]

  @@unique([organizationId, kind, slug])
  @@index([organizationId, kind, sortOrder])
  @@map("finance_categories")
}

/// One financial transaction.
model FinanceEntry {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// "revenue" | "expense". Mirrors the category's kind; stored on the entry
  /// so aggregate queries never need the join.
  kind String

  /// The day the money moved, normalised to UTC midnight so period bucketing
  /// is not sensitive to the reporter's timezone.
  occurredOn DateTime

  /// Original amount in minor units, and the currency it was actually
  /// transacted in. These two columns are the source of truth and are never
  /// rewritten by a later rate change.
  amountMinor Int
  currency    String

  /// The same amount converted into the organization's base currency at the
  /// time of entry, plus the rate used. Stored rather than computed so a
  /// historical report does not silently change when a rate is updated.
  baseAmountMinor Int
  baseCurrency    String
  exchangeRate    Float  @default(1)

  categoryId String?
  category   FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  /// Null means company-wide rather than attributable to one channel.
  channelId String?
  channel   Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  /// Revenue only: "youtube_ads", "sponsorship", "affiliate", ... Free text so
  /// platforms are not a migration.
  platform String?

  /// Expense only: who was paid.
  vendor String?

  notes String?

  /// Where this row came from: "manual" | "youtube".
  ///
  /// An imported figure and a typed one are not the same kind of fact, and the
  /// UI must be able to say so. It also decides who may edit the row — an
  /// imported amount that a person can silently overwrite stops reconciling on
  /// the next sync.
  source String @default("manual")

  /// Stable key for an imported row, e.g. "youtube:UC123:2026-08".
  ///
  /// THE IDEMPOTENCY MECHANISM. The sync upserts on (organization, source,
  /// externalId), so re-running it updates the existing row rather than adding
  /// a second one. Null for manual entries, and NULLs do not collide in a
  /// unique index on either connector, so hand-typed rows are unaffected.
  externalId String?

  /// True when the figure is an estimate that the source may still revise.
  ///
  /// YouTube's revenue metrics are explicitly "subject to month-end
  /// adjustment", so presenting one as settled cash would be wrong. The
  /// finance screens label it rather than hiding the distinction.
  isEstimated Boolean @default(false)

  /// Set when an import overwrote a different figure, so a changed number is
  /// visible as a change rather than appearing to have always been that.
  previousAmountMinor Int?
  revisionCount       Int       @default(0)
  lastImportedAt      DateTime?

  createdById String?
  createdBy   AppUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, source, externalId])
  @@index([organizationId, kind, occurredOn])
  @@index([organizationId, channelId, occurredOn])
  @@index([categoryId])
  @@map("finance_entries")
}

/// An admin-maintained conversion rate.
///
/// Deliberately manual by default: silently inventing a rate from an unnamed
/// source would put unverifiable numbers in a financial report. If a rate
/// provider is configured it fills this table, and every entry still records
/// the rate it actually used.
model ExchangeRate {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// ISO 4217 codes. `rate` converts 1 unit of `fromCurrency` into
  /// `toCurrency`.
  fromCurrency String
  toCurrency   String
  rate         Float

  /// Where the number came from: "manual" | "<provider name>".
  source String @default("manual")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, fromCurrency, toCurrency])
  @@map("exchange_rates")
}

// ---------------------------------------------------------------------------
// TEAM, EMPLOYMENT AND PAYROLL
//
// Deliberately built on the models that already exist rather than beside them.
// An "employee" is an OrganizationMember — the same row that carries their role
// and permissions — with employment facts attached. A "hit" is decided by the
// niche's existing `hitThreshold`, the same number the dashboard, the charts
// and the PDF report all read. There is exactly one definition of a hit in this
// system, and payroll uses it rather than owning a second copy.
// ---------------------------------------------------------------------------

/// Which niches a member is assigned to.
///
/// Two jobs at once, which is why it hangs off the membership rather than off
/// an employment record:
///   • Payroll — a hit only counts toward someone's pay if it happened in a
///     niche they are assigned to.
///   • Access — roles marked niche-scoped in src/lib/auth/roles.ts see only the
///     channels in their assigned niches. That filtering happens server-side,
///     in the same query that already scopes by organization.
model MemberNiche {
  id String @id @default(cuid())

  memberId String
  member   OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  nicheId String
  niche   Niche  @relation(fields: [nicheId], references: [id], onDelete: Cascade)

  /// Attribution for the audit trail: who put this person on this niche.
  assignedById String?
  assignedAt   DateTime @default(now())

  @@unique([memberId, nicheId])
  @@index([nicheId])
  @@map("member_niches")
}

/// Employment and pay configuration for one person.
///
/// Separate from OrganizationMember on purpose. Salary is the most sensitive
/// field in this database, and keeping it in its own table means the ordinary
/// member queries — the ones behind /api/admin/users, the dataset payload, the
/// audit log — cannot leak it by widening a `select`. Reaching pay requires
/// deliberately joining this table, which happens only behind `payroll.view`.
model EmployeeProfile {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String  @unique
  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Fixed monthly pay, in integer minor units — never a float. Shares the
  /// representation and the helpers in src/lib/finance/money.ts.
  salaryMinor Int @default(0)

  /// Paid once per qualifying hit, on top of salary.
  hitPaymentMinor Int @default(0)

  currency String @default("USD")

  /// Employment dates. A period is only paid to someone who was employed during
  /// it, which is what stops a leaver appearing on next month's run.
  joinedOn          DateTime?
  employmentEndedOn DateTime?

  /// Free-text, admin-only. Never surfaced outside the payroll screens.
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("employee_profiles")
}

/// One calendar month of payroll.
///
/// Periods are explicit rows rather than something derived from dates on the
/// fly, because "what did we actually pay in August" must keep its answer after
/// somebody edits a salary in September.
model PayrollPeriod {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  year  Int
  /// 1-12.
  month Int

  /// Half-open window [startsAt, endsAt) in UTC, matching how every other date
  /// range in this codebase is handled.
  startsAt DateTime
  endsAt   DateTime
  /// The first of the following month.
  payOn    DateTime

  /// "open" | "finalized" | "paid".
  ///
  /// An open period is recalculated live as views change. Finalizing freezes
  /// it: the records below stop being derived and become the record of what was
  /// owed. That transition is what makes historical payroll reproducible.
  status String @default("open")

  finalizedAt   DateTime?
  finalizedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  records       PayrollRecord[]
  notifications PayrollNotification[]

  @@unique([organizationId, year, month])
  @@index([organizationId, status])
  @@map("payroll_periods")
}

/// What one person earned in one period.
model PayrollRecord {
  id String @id @default(cuid())

  periodId String
  period   PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  /// Intentionally NOT a foreign key.
  ///
  /// A payroll record is a financial document. It has to survive the deletion
  /// of the account it refers to, and a cascade — or a null — would erase
  /// evidence of a payment that really happened. The identifying details below
  /// are copied in at finalization for the same reason.
  userId String

  employeeName  String
  employeeEmail String
  roleAtRun     String

  baseSalaryMinor Int
  hitPaymentMinor Int
  hitCount        Int
  hitBonusMinor   Int

  /// Manual correction by an administrator, positive or negative. Kept apart
  /// from the computed figures so the original calculation stays legible and
  /// the adjustment is obvious.
  adjustmentMinor  Int     @default(0)
  adjustmentReason String?

  totalMinor Int
  currency   String @default("USD")

  /// "pending" | "paid"
  paymentStatus String    @default("pending")
  paidAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hits PayrollHit[]

  @@unique([periodId, userId])
  @@index([userId])
  @@map("payroll_records")
}

/// One Short that earned a bonus.
///
/// THIS TABLE IS THE ANTI-DOUBLE-COUNT GUARANTEE. The unique constraint on
/// (record, video) makes it impossible for the same Short to be paid twice
/// within one person's period, whatever a re-sync, a re-run or a duplicate
/// request does. Recalculation writes the same rows and the constraint absorbs
/// them.
///
/// It is also the answer to "which Shorts did I pay for?", captured with the
/// view count and threshold as they stood — so a bonus can be explained months
/// later even after the video's counter has moved on.
model PayrollHit {
  id String @id @default(cuid())

  recordId String
  record   PayrollRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  videoId String

  /// Snapshots, for the same reason the record copies the employee's name.
  videoTitle     String
  channelId      String?
  channelName    String
  nicheId        String?
  nicheName      String
  thresholdAtRun Int
  viewCountAtRun BigInt
  publishedAt    DateTime

  @@unique([recordId, videoId])
  @@index([videoId])
  @@map("payroll_hits")
}

/// One notification attempt per period, per channel.
///
/// The unique constraint is the duplicate-send protection: the scheduled job
/// claims the row before it sends, so a second invocation — a retry, an
/// overlapping cron, a manual trigger — finds the row already there and stops.
model PayrollNotification {
  id String @id @default(cuid())

  periodId String
  period   PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  /// "telegram". Room for another channel without a migration.
  channel String @default("telegram")

  /// "pending" | "sent" | "failed"
  status   String @default("pending")
  attempts Int    @default(0)

  /// Surfaced to the admin so a silent failure is not silent.
  lastError String?
  sentAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([periodId, channel])
  @@map("payroll_notifications")
}

/// Where notifications go.
///
/// The destination is configurable data; the bot token is not. The token lives
/// in TELEGRAM_BOT_TOKEN and never enters the database, never reaches a DTO and
/// never appears in a log — a chat id is harmless on its own, a bot token is
/// the whole bot.
model NotificationSettings {
  id String @id @default(cuid())

  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  telegramChatId  String?
  telegramEnabled Boolean @default(false)

  /// Lets an admin mute the monthly summary without disconnecting Telegram.
  payrollNotificationsEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_settings")
}

// ---------------------------------------------------------------------------
// CONTENT TYPES
//
// A second, independent way to slice the same Shorts. A niche says WHAT GAME a
// channel covers; a content type says WHAT KIND OF VIDEO it is — a funny
// moment, a ranking, a cutscene. They are orthogonal on purpose: "which content
// type performs best in GTA" is the question this exists to make answerable,
// and it is only answerable if the two are separate dimensions rather than one
// merged taxonomy.
//
// Nothing here is hardcoded. The catalogue is rows, editable by an admin, the
// same way niches and finance categories already are.
// ---------------------------------------------------------------------------

/// A kind of video WITHIN ONE NICHE: "Funny Meme" in GTA, "Story Moment" in RDR.
///
/// Deliberately NOT a global list. A single catalogue shared by every niche
/// would offer "Cinematics" against a TLOU Short and "Emotional Moments"
/// against a GTA one, and the vocabulary each niche actually argues in would be
/// buried in everybody else's. Two niches may both have a "Character Moments"
/// — they are separate rows, because they are separate things that happen to
/// share a name, and merging them would make "which content type performs best"
/// a question about a label rather than about the work.
model ContentType {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name String

  /// Lowercased name — the portable case-insensitive uniqueness trick
  /// `Niche.slug` and `FinanceCategory.slug` already use, because SQLite and
  /// PostgreSQL disagree about case-insensitive collation.
  slug String

  /// A `--chart-N` index, so a tag is recognisable at a glance.
  colorIndex Int @default(0)
  sortOrder  Int @default(0)

  /// Archived rather than deleted wherever it is in use: retiring a tag stops
  /// it being offered on new work while every Short already carrying it keeps
  /// its label. A tag nothing references can be removed outright.
  isActive Boolean @default(true)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  channelRules ChannelContentTypeRule[]
  videos       VideoContentType[]

  @@unique([organizationId, slug])
  @@index([organizationId, sortOrder])
  @@map("content_types")
}

/// "Everything this channel makes is a Funny Meme" — with an expiry date it
/// writes for itself.
///
/// This replaces the flat channel-to-tag join, which had no notion of WHEN. A
/// channel that produced rankings all last year and switched to cutscenes in
/// March would go on tagging every new upload "Ranking" forever, and the tag
/// nobody trusts is worse than the tag nobody set.
///
/// So a rule is a claim about a STRETCH OF TIME: Shorts published on or after
/// `effectiveFrom`, and before `effectiveUntil` if it is set, carry the tag.
/// Applying one from a Short covers that channel's whole back catalogue and
/// everything it publishes next, which is what somebody means when they say
/// "this is what this channel does".
///
/// HOW IT NOTICES THE CHANNEL CHANGED
/// Not by reading titles, which would be guessing. By listening to the only
/// reliable signal there is — somebody taking the tag off. Each time a person
/// removes this tag from a Short newer than the rule's last confirmation, the
/// streak grows; three in a row and the rule closes itself, dated to the first
/// Short in the streak rather than to today, because that is when the channel
/// actually changed. Putting the tag back on a newer Short clears the streak.
///
/// The effect is a rule that keeps working while it is right and retires
/// quietly when it stops being, without anybody having to remember it exists.
model ChannelContentTypeRule {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  trackedChannelId String
  trackedChannel   TrackedChannel @relation(fields: [trackedChannelId], references: [id], onDelete: Cascade)

  contentTypeId String
  contentType   ContentType @relation(fields: [contentTypeId], references: [id], onDelete: Cascade)

  /// Shorts published at or after this instant are covered.
  effectiveFrom DateTime

  /// Shorts published before this are covered; null means the rule is still
  /// claiming new uploads. Set by hand, or by the streak below.
  effectiveUntil DateTime?

  /// Consecutive removals on Shorts newer than the last confirmation.
  consecutiveOverrides Int @default(0)

  /// The publish date of the earliest Short in the current streak — where the
  /// rule gets closed if the streak completes. Dating the close to the removal
  /// rather than to the day somebody noticed is the difference between a
  /// correct history and a tidy one.
  overrideStreakFrom DateTime?

  /// Set when the streak closed it, so the UI can say the rule retired itself
  /// rather than letting it look like somebody did it.
  autoClosedAt DateTime?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// One rule per tag per start date, so a channel can legitimately carry
  /// "Ranking until March" and "Ranking again from September".
  @@unique([trackedChannelId, contentTypeId, effectiveFrom])
  @@index([organizationId])
  @@index([contentTypeId])
  @@map("channel_content_type_rules")
}

/// The content type(s) of one Short.
///
/// CARRIES organizationId ON PURPOSE. `Video` is a global, deduplicated row —
/// the same YouTube video is one record however many organizations track its
/// channel — so a classification hung off it alone would be visible to all of
/// them. The organization is stored here so a query can be scoped without
/// joining through ContentType, and so the unique constraint is per-team.
///
/// Many-to-many because a Short genuinely can be two things at once ("Character
/// Moment + Funny Moment"). The UI does not force a second choice.
model VideoContentType {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  videoId String
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  contentTypeId String
  contentType   ContentType @relation(fields: [contentTypeId], references: [id], onDelete: Cascade)

  /// Attribution, so a bulk assignment can be traced back to whoever ran it.
  /// "manual" | "excluded" — and note what is NOT in that list.
  ///
  /// INHERITED TAGS ARE NEVER STORED. A Short's effective content types are
  /// computed, every time, as:
  ///
  ///     (the channel's tags − this Short's exclusions) ∪ this Short's manual tags
  ///
  /// That is the whole design, and it is why this column exists rather than a
  /// row per inherited tag. Copying the channel's tags onto each Short would
  /// make the relationship a one-time snapshot: removing a tag from a channel
  /// with 400 Shorts would leave 400 stale rows behind, and adding one later
  /// would reach nothing already published. The channel stays the live source
  /// and a Short only records where it DIFFERS from its channel.
  ///
  /// So a row here is always a deviation:
  ///   "manual"   — this Short carries a tag its channel does not.
  ///   "excluded" — this Short refuses a tag its channel does have. A
  ///                tombstone, deliberately kept even after the channel drops
  ///                the tag, because somebody said no to it once and re-adding
  ///                it to the channel must not silently undo that.
  ///
  /// The two are mutually exclusive by construction: one row per
  /// (organization, video, content type), so a Short cannot both add and refuse
  /// the same tag, and the unique constraint below is what enforces it.
  state String @default("manual")

  assignedById String?
  assignedAt   DateTime @default(now())

  @@unique([organizationId, videoId, contentTypeId])
  @@index([organizationId, contentTypeId])
  @@index([videoId])
  @@map("video_content_types")
}

// ---------------------------------------------------------------------------
// YOUTUBE REVENUE
//
// Revenue is NOT available from the YouTube Data API that powers the rest of
// this app. It comes from a different service — the YouTube Analytics API at
// youtubeanalytics.googleapis.com — under a different scope,
// yt-analytics-monetary.readonly, and only for channels in the YouTube Partner
// Programme.
//
// The daily rows below are the raw record as reported. Finance entries are
// derived from them, which is what makes a revised figure a correction to one
// row rather than a second payment appearing in the ledger.
// ---------------------------------------------------------------------------

/// One channel's reported revenue for one day.
model ChannelRevenueDay {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  /// Which connection reported it. Kept so a figure can be traced to the
  /// Google account that authorised reading it.
  connectionId String?

  /// The reported day, at UTC midnight — the granularity the Analytics API
  /// returns and the unit a revision applies to.
  day DateTime

  /// Integer minor units, like every other amount in this system.
  estimatedRevenueMinor           Int @default(0)
  estimatedAdRevenueMinor         Int @default(0)
  estimatedRedPartnerRevenueMinor Int @default(0)

  /// The currency YouTube reported in, which is the channel's payout currency
  /// and not necessarily the organization's base.
  currency String @default("USD")

  /// Revision tracking. YouTube states plainly that these figures are subject
  /// to month-end adjustment, so a day's value moving is expected rather than
  /// exceptional — and worth being able to see.
  previousEstimatedRevenueMinor Int?
  revisionCount                 Int  @default(0)

  fetchedAt DateTime @default(now())

  @@unique([organizationId, channelId, day])
  @@index([organizationId, day])
  @@index([channelId, day])
  @@map("channel_revenue_days")
}

/// What a Short did inside its window, decided once and kept.
///
/// WHY THIS IS STORED RATHER THAN COMPUTED
/// Answering "did it reach 500,000 within 7 days" means finding the snapshot
/// nearest the window's close — a per-video lookup that would run across the
/// whole library on every dashboard load. It also never changes: views at day
/// seven is a historical fact, so once the window shuts the answer is final and
/// recomputing it is pure cost.
///
/// THE FOUR OUTCOMES, and the two that usually get skipped
///   "hit"     the Short reached the bar inside the window. Either observed at
///             the close, or observed EARLIER and already past it — views only
///             rise, so a Short over the bar on day two is a hit on day seven.
///   "miss"    the window shut and it was short. Also reachable without any
///             history at all: if a Short's LIFETIME total is still under the
///             bar today, it cannot have cleared it inside the window. That one
///             inference rescues 80% of the existing library.
///   "pending" the window is still open. Counted in NEITHER half of the rate —
///             this is the mechanism that removes the age bias, rather than a
///             correction applied afterwards.
///   "unknown" the window shut, nobody was recording, and the Short did
///             eventually pass the bar — so it might have taken two days or two
///             years. Excluded and COUNTED, because these are disproportionately
///             the winners and quietly dropping them would bias every rate
///             downward while looking clean.
model VideoHitEvaluation {
  id String @id @default(cuid())

  /// The verdict belongs to the organization, not the video: `Video` is a global
  /// deduplicated row and the rule that judged it is one team's niche setting.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  videoId String
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  /// "hit" | "miss" | "pending" | "unknown"
  outcome String

  /// Which niche's rule decided it. Null when the Short's channel sits in no
  /// niche, or in none that is configured — a state the UI names rather than
  /// scoring as a miss.
  nicheId String?

  /// The rule as it stood, copied rather than referenced.
  ///
  /// An admin who raises a threshold in March must not silently rewrite what
  /// February's Shorts achieved, and payroll needs to explain a bonus paid
  /// months ago against the bar that actually applied at the time.
  thresholdApplied   Int?
  windowHoursApplied Int?

  /// What we saw, and how old the Short was when we saw it.
  ///
  /// `observedAtHours` is the honesty column: a verdict read from a snapshot at
  /// 6 hours on a 168-hour window is a different quality of evidence from one
  /// read at 167, and a screen that shows the outcome without it is overstating
  /// what the database knows.
  viewsAtWindow   BigInt?
  observedAtHours Int?

  windowClosesAt DateTime?
  evaluatedAt    DateTime  @default(now())

  @@unique([organizationId, videoId])
  @@index([organizationId, outcome])
  @@index([organizationId, windowClosesAt])
  @@map("video_hit_evaluations")
}
